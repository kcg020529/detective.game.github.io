{
  "uid": "kervion-security-audit",
  "title": "Kervion 입력 보안 감사",
  "description": "Input Guard 경고 메타데이터만 표시합니다. 질문 원문과 AI 답변은 표시하지 않습니다.",
  "tags": ["kervion", "security", "audit"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "현재 수집 범위",
      "type": "text",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 3},
      "options": {
        "mode": "markdown",
        "content": "이 화면은 **저장된 Input Guard 경고(warn·high_risk)**만 집계합니다. allow 질문은 감사 테이블에 저장하지 않으므로 전체 질문 수나 차단율을 뜻하지 않습니다. 현재 채팅 전송 API와 감사 자동 저장은 미연결입니다. 데이터가 없다면 패널은 0 또는 빈 그래프로 보입니다."
      }
    },
    {
      "id": 2,
      "title": "경고 이벤트",
      "type": "stat",
      "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
      "gridPos": {"x": 0, "y": 3, "w": 12, "h": 4},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM audit_events WHERE event_type = 'input_guard_alert' AND $__timeFilter(occurred_at)"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value"}
    },
    {
      "id": 3,
      "title": "고위험 경고",
      "type": "stat",
      "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
      "gridPos": {"x": 12, "y": 3, "w": 12, "h": 4},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM audit_events WHERE event_type = 'input_guard_alert' AND level = 'high_risk' AND $__timeFilter(occurred_at)"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value"}
    },
    {
      "id": 4,
      "title": "시간별 경고",
      "type": "timeseries",
      "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(occurred_at, '1h'), level AS metric, COUNT(*) AS value FROM audit_events WHERE event_type = 'input_guard_alert' AND $__timeFilter(occurred_at) GROUP BY 1, level ORDER BY 1"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "title": "캐릭터별 경고",
      "type": "barchart",
      "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 8},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT character_id AS ai_id, COUNT(*) AS alerts FROM audit_events WHERE event_type = 'input_guard_alert' AND $__timeFilter(occurred_at) AND character_id IS NOT NULL GROUP BY character_id ORDER BY alerts DESC"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"orientation": "horizontal", "xField": "ai_id", "showValue": "always", "legend": {"displayMode": "hidden"}}
    },
    {
      "id": 6,
      "title": "최근 경고 메타데이터",
      "type": "table",
      "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
      "gridPos": {"x": 0, "y": 15, "w": 24, "h": 9},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "mysql", "uid": "kervion-audit-mariadb"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT occurred_at AS time, level, character_id, signals_json AS signals FROM audit_events WHERE event_type = 'input_guard_alert' AND $__timeFilter(occurred_at) ORDER BY occurred_at DESC LIMIT 100"
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm"}
    }
  ]
}
