          "rawSql": "SELECT occurred_at AS time, CASE WHEN (JSON_UNQUOTE(JSON_EXTRACT(signals_json, '$.applied')) = 'block' AND (JSON_CONTAINS(JSON_EXTRACT(signals_json, '$.signals'), JSON_QUOTE('broken')) = 1 OR COALESCE(JSON_UNQUOTE(JSON_EXTRACT(signals_json, '$.signals[0]')), 'unknown') NOT IN ('canary', 'api_key', 'pii', 'context_leak', 'prompt_leak'))) THEN '🔴 응답 중단' WHEN JSON_UNQUOTE(JSON_EXTRACT(signals_json, '$.applied')) = 'block' THEN '🔴 제한 답변 대체' WHEN JSON_UNQUOTE(JSON_EXTRACT(signals_json, '$.applied')) = 'mask' THEN '🟠 마스킹 후 전송' WHEN JSON_UNQUOTE(JSON_EXTRACT(signals_json, '$.decision')) = 'block' AND JSON_UNQUOTE(JSON_EXTRACT(signals_json, '$.applied')) = 'allow' THEN '🟠 관찰 후 진행' ELSE '⚪ 기록' END AS handling, JSON_UNQUOTE(JSON_EXTRACT(signals_json, '$.decision')) AS decision, JSON_UNQUOTE(JSON_EXTRACT(signals_json, '$.applied')) AS applied, JSON_UNQUOTE(JSON_EXTRACT(signals_json, '$.mode')) AS mode, character_id, JSON_EXTRACT(signals_json, '$.signals') AS signals, request_id FROM audit_events WHERE event_type = 'output_guard_alert' AND $__timeFilter(occurred_at) ORDER BY occurred_at DESC, event_id DESC LIMIT 100"
