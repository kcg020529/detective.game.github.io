    {
      "id": 6,
      "title": "최근 입력 검사 · 판정과 처리",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "kervion-audit-mariadb"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "kervion-audit-mariadb"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT occurred_at AS time, CASE WHEN JSON_CONTAINS(signals_json, JSON_QUOTE('role_or_state_override')) = 1 THEN '🟢 권한·상태 변경 시도' WHEN level = 'high_risk' AND continue_processing = 0 THEN '🔴 일반 생성 중단' WHEN level = 'high_risk' THEN '🟠 고위험 관찰' WHEN level = 'warn' THEN '🟠 입력 경고' ELSE '⚪ 기타' END AS handling, level, CASE WHEN continue_processing = 0 THEN '일반 답변 생성 건너뜀' ELSE '일반 답변 생성 진행' END AS processing, character_id, signals_json AS signals, request_id FROM audit_events WHERE event_type = 'input_guard_alert' AND $__timeFilter(occurred_at) ORDER BY occurred_at DESC, event_id DESC LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "handling"
            },
            "properties": [
