# MariaDB 관리자 비밀번호. 복사 후 원하는 값으로 변경 (로컬 전용, 127.0.0.1에서만 접속됨).
MARIADB_ROOT_PASSWORD=change-me

# 초기 데이터베이스와 일반 계정 설정.
MARIADB_DATABASE=kervion
MARIADB_USER=kervion
MARIADB_PASSWORD=change-me

# 호스트에서 MariaDB에 연결할 포트.
MARIADB_PORT=3306

# 웹 화면을 열 로컬 포트
WEB_PORT=8080

# 추후 Planner 연동 시 사용
# DEEPSEEK_API_KEY=
# DEEPSEEK_PLANNER_API_KEY=

# Grafana는 docker-compose.grafana.yml을 함께 사용할 때만 필요하다.
# 실제 비밀번호는 infrastructure/docker/.env에 설정하고 Git에 올리지 않는다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_USER=grafana_reader
GRAFANA_DB_PASSWORD=
GRAFANA_PORT=3000
