# MariaDB 관리자 비밀번호. 복사 후 원하는 값으로 변경 (로컬 전용, 127.0.0.1에서만 접속됨).
MARIADB_ROOT_PASSWORD=change-me

# 초기 데이터베이스와 일반 계정 설정.
MARIADB_DATABASE=kervion
MARIADB_USER=kervion
MARIADB_PASSWORD=change-me

# 호스트에서 MariaDB에 연결할 포트.
MARIADB_PORT=3306

# 웹 화면을 열 로컬 포트
WEB_PORT=8080

# 캐릭터 AI·Planner용 DeepSeek 키. 실제 값은 .env에만 넣고 Git에 올리지 않는다. 비우면 채팅은 503.
DEEPSEEK_API_KEY=
DEEPSEEK_PLANNER_API_KEY=
