FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FASTEMBED_CACHE_PATH=/home/app/.cache/fastembed

WORKDIR /app

COPY backend/requirements.txt /tmp/backend-requirements.txt
COPY backend/rag/requirements.txt /tmp/rag-requirements.txt
COPY database/loaders/requirements.txt /tmp/loader-requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/backend-requirements.txt \
    -r /tmp/rag-requirements.txt -r /tmp/loader-requirements.txt \
    && useradd --create-home --uid 10001 app \
    && mkdir -p /home/app/.cache/fastembed \
    && chown -R app:app /home/app

COPY --chown=app:app backend/ /app/backend/
COPY --chown=app:app database/ /app/database/
COPY --chown=app:app data/ /app/data/
COPY --chown=app:app infrastructure/docker/migrate.py /app/infrastructure/docker/migrate.py

USER app

CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
