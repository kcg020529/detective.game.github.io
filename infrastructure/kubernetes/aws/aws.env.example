# 실제 값은 gitignore된 aws.env에만 저장한다.
AWS_REGION=ap-northeast-2
ECR_REGISTRY=
# aws-cloudfront.sh create가 출력한 dXXXX.cloudfront.net 주소.
DOMAIN=
# 한 번 조회: aws ec2 describe-managed-prefix-lists --filters Name=prefix-list-name,Values=com.amazonaws.global.cloudfront.origin-facing --query 'PrefixLists[0].PrefixListId' --output text
CF_PREFIX_LIST=
CLUSTER_NAME=kervion
# eksctl 컨텍스트 이름: kubectl config get-contexts로 확인한다.
KUBE_CONTEXT=
