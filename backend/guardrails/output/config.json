{
  "_note": "모든 값은 초안이다. 임계값은 tune 분할로 잠정 설정했고(README·결과 보고서 참고) test 결과는 임계값 선택에 쓰지 않았다. 사용자에게 보이는 고정 문구와 Canary·키·개인정보 값은 확정 전 자리표시이며 확정되면 이 파일만 바꾼다.",
  "mode": "shadow",
  "mode_help": "shadow: 점수형 검사(비인가 Context·프롬프트 유출·무관·반복·페르소나 이탈)는 판정만 기록하고 응답은 그대로 보낸다. enforce: 판정대로 적용한다. Canary·키·개인정보·깨진 응답은 shadow에서도 항상 적용한다.",
  "always_enforced": ["canary", "api_key", "pii", "broken"],

  "secrets": {
    "canary": ["CANARY-EXAMPLE-0001"],
    "api_keys": ["dummy-key-EXAMPLE-0001"],
    "pii_values": ["example.user@example.invalid", "010-0000-0000", "000000-0000000"],
    "pii_format_regex": true,
    "partial_match_for": ["canary", "api_key"],
    "partial_min_ratio": 0.5,
    "partial_min_chars": 8
  },

  "actions": {"canary": "block", "api_key": "block", "pii": "mask"},

  "thresholds": {
    "context_leak": {"low": 0.40, "high": 0.60},
    "prompt_leak":  {"low": 0.50, "high": 0.80},
    "degenerate":   {"low": 0.50, "high": 0.90},
    "irrelevant":   {"low": 0.40, "high": 0.80}
  },
  "context_generic": {"df_ratio": 0.10},
  "generic_entities": [],
  "gray_zone_action": "allow_log",

  "events": {
    "canary": "alert", "api_key": "alert", "pii": "alert",
    "context_leak": "alert", "prompt_leak": "alert",
    "irrelevant": "log", "degenerate": "log", "persona_break": "log", "broken": "log",
    "gray": "log"
  },

  "fallback": {
    "_note": "사용자에게 보이는 문구는 [미정]. D의 고정 문구와 맞출 때까지의 자리표시.",
    "leak": "그 부분은 지금 말씀드리기 어려워요.",
    "off_topic": "그건 이번 실험과 관련이 없는 이야기라 대답하기 어려워요.",
    "error": "지금은 답을 드리기 어려워요. 다시 한 번 물어봐 주세요."
  },
  "fallback_by_reason": {
    "canary": "leak", "api_key": "leak", "pii": "leak", "context_leak": "leak", "prompt_leak": "leak",
    "irrelevant": "off_topic", "persona_break": "off_topic", "degenerate": "error", "broken": "error"
  },
  "block_priority": ["canary", "api_key", "pii", "context_leak", "prompt_leak", "persona_break", "irrelevant", "degenerate", "broken"],

  "generic_phrases": ["모르겠어", "모르겠어요", "몰라요", "정확히는", "아직", "확인하지 못했", "못했어"],
  "generic_phrases_note": "어느 대화에나 나오는 말은 비인가 Context 근거에서 뺀다. 실제 DeepSeek 정상 응답을 모으면 자주 나오는 표현으로 자동 보강할 수 있다.",

  "persona_break_phrases": ["대규모 언어 모델", "언어 모델", "language model", "as an ai", "저는 ai 어시스턴트"],

  "relevance": {
    "_note": "게임 어휘는 A(게임 데이터)에서 받아 채울 것. 지금은 평가용 합성 기록(data/test-data/records.json)에서 뽑은 어휘 + 일반 표현이다.",
    "domain_terms": ["실험", "회차", "기록", "대화", "점수", "조사", "단서", "목격", "서버실", "관찰실", "제한 구역", "보관함", "실험실"],
    "witness_terms": ["봤", "본 적", "본적", "들었", "들은", "기억", "모르", "몰라", "알고 있", "알아요", "확인했", "겪지", "목격", "말씀"],
    "refusal_terms": ["공개할 수 없", "말씀드릴 수 없", "말씀드리기 어려", "대답하기 어려", "답하기 어려", "관련이 없", "도와드릴 수 없", "알려드릴 수 없"],
    "min_clause_chars": 6,
    "long_irrelevant_chars": 15,
    "short_chars": 12,
    "short_chars_if_question_off_topic": 24
  }
}
