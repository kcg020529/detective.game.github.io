# LLM 연결 설정 예시. 실제 키는 이 파일이 아니라 .env에 넣는다. (.env는 Git에 올라가지 않는다)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 선택: 아래 값은 비워 두면 기본값을 쓴다.
# LLM_TEMPERATURE=0.8
# LLM_MAX_TOKENS=400
# LLM_TIMEOUT_SEC=30
# LLM_RETRIES=1   # 빈 응답·서버 과부하 등 일시적 오류일 때 다시 보내는 횟수 (0~5, 0이면 재시도 안 함)
